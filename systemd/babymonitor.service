[Unit]
Description=Baby monitor camera stream
# Never give up restarting, however often it crashes.
StartLimitIntervalSec=0

[Service]
User=babymonitor
SupplementaryGroups=video
# Lets the unprivileged user bind port 80 (http://babymonitor.local with no port).
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=BABYMONITOR_CONFIG=/boot/firmware/babymonitor.conf
ExecStart=/usr/bin/python3 /opt/babymonitor/server.py
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
