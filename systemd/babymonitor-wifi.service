[Unit]
Description=Baby monitor: apply Wi-Fi settings from babymonitor.conf
Requires=NetworkManager.service
After=NetworkManager.service
Before=network-online.target

[Service]
Type=oneshot
Environment=BABYMONITOR_CONFIG=/boot/firmware/babymonitor.conf
ExecStart=/opt/babymonitor/wifi-setup.sh
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
